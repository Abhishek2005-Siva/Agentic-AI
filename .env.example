# SEC Intelligence Platform Configuration

# ============================================================================
# SEC EDGAR API
# ============================================================================
SEC_API_BASE=https://www.sec.gov/cgi-bin/browse-edgar
SEC_FILINGS_API=https://www.sec.gov/Archives
SEC_RATE_LIMIT_DELAY=0.1

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sec_intelligence
DB_USER=sec_user
DB_PASSWORD=sec_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ============================================================================
# VECTOR STORE (Qdrant)
# ============================================================================
VECTORSTORE_QDRANT_URL=http://localhost:6333
VECTORSTORE_QDRANT_API_KEY=
VECTORSTORE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORSTORE_EMBEDDING_DIM=384
VECTORSTORE_COLLECTION_NAME=sec_filings

# ============================================================================
# OBJECT STORAGE
# ============================================================================
STORAGE_BASE_PATH=/tmp/sec_storage
STORAGE_RAW_FILINGS_PATH=raw_filings
STORAGE_PROCESSED_FILINGS_PATH=processed_filings

# ============================================================================
# LLM (GPT-4o mini)
# ============================================================================
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ============================================================================
# RETRIEVAL
# ============================================================================
RETRIEVAL_BM25_WEIGHT=0.3
RETRIEVAL_VECTOR_WEIGHT=0.7
RETRIEVAL_INITIAL_RETRIEVAL_K=30
RETRIEVAL_RERANKED_K=5
RETRIEVAL_USE_RERANKING=true
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# ============================================================================
# AGENTS
# ============================================================================
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300
AGENT_BATCH_SIZE=10

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=SEC Intelligence Platform
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
